# Which bridge to route through: "openai", "claude", or "deepseek". Defaults to "openai".
# CLI: can also be passed per-run as --provider openai|claude|deepseek
# Server: this is just the default; the chat UI's provider dropdown (or a
# request's forwardedProps.provider) overrides it per AG-UI run.
PROVIDER=claude

# Port for `npm run serve` / `npm run dev:serve` (the AG-UI HTTP server + chat UI)
PORT=3000

# Override only if you're pointing at a different GitHub MCP endpoint
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Needed when PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Needed when PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Needed when PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Override only for a different (e.g. self-hosted/proxied) OpenAI-compatible endpoint
# DEEPSEEK_BASE_URL=https://api.deepseek.com
