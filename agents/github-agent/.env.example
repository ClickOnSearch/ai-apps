# Which bridge to route through: "openai" or "claude". Defaults to "openai".
# CLI: can also be passed per-run as --provider openai|claude
# Server: this is just the default; the chat UI's provider dropdown (or a
# request's forwardedProps.provider) overrides it per AG-UI run.
PROVIDER=claude

# Port for `npm run serve` / `npm run dev:serve` (the AG-UI HTTP server + chat UI)
PORT=3000

# GitHub's remote MCP server (https://api.githubcopilot.com/mcp/) needs a token
# with the scopes for whatever you'll ask it to do (repo, read:org, etc.)
GITHUB_TOKEN=

# Override only if you're pointing at a different GitHub MCP endpoint
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Needed when PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Needed when PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
