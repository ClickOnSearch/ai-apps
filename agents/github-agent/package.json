{
  "name": "@clickonsearch/github-agent",
  "version": "0.1.3",
  "description": "Agent that talks to GitHub via the GitHub remote MCP server, routed through the OpenAI, Claude, or DeepSeek remote MCP bridge depending on user preference. Ships an AG-UI protocol server plus a browser chat UI for end users.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickOnSearch/ai-apps.git",
    "directory": "agents/github-agent"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "public"
  ],
  "main": "dist/index.js",
  "bin": {
    "github-agent": "dist/cli.js",
    "github-agent-serve": "dist/server-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "serve": "node dist/server-cli.js",
    "dev:serve": "tsx src/server-cli.ts"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.0",
    "@ag-ui/encoder": "^1.0.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "@clickonsearch/agent-skills": "^0.1.0",
    "@clickonsearch/claude-remote-mcp-bridge": "^0.3.0",
    "@clickonsearch/deepseek-remote-mcp-bridge": "^0.3.0",
    "@clickonsearch/openai-remote-mcp-bridge": "^0.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "openai": "^7.47.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
