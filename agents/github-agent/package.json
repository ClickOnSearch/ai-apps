{
  "name": "github-agent",
  "version": "0.1.0",
  "description": "Agent that talks to GitHub via the GitHub remote MCP server, routed through either the OpenAI or Claude remote MCP bridge depending on user preference. Ships an AG-UI protocol server plus a browser chat UI for end users.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "github-agent": "dist/cli.js",
    "github-agent-serve": "dist/server-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "serve": "node dist/server-cli.js",
    "dev:serve": "tsx src/server-cli.ts"
  },
  "dependencies": {
    "openai-remote-mcp-bridge": "*",
    "claude-remote-mcp-bridge": "*",
    "openai": "^4.68.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "@ag-ui/core": "^1.0.0",
    "@ag-ui/encoder": "^1.0.0",
    "express": "^4.21.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17"
  },
  "engines": {
    "node": ">=18"
  }
}
