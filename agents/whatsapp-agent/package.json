{
  "name": "@clickonsearch/whatsapp-agent",
  "version": "0.1.0",
  "description": "Personal WhatsApp assistant, usable two ways: message yourself on WhatsApp to give it instructions, or drive it from a browser chat UI over the AG-UI protocol. Routed through OpenAI, Claude, or DeepSeek depending on preference.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickOnSearch/ai-apps.git",
    "directory": "agents/whatsapp-agent"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "public"
  ],
  "main": "dist/index.js",
  "bin": {
    "whatsapp-agent": "dist/cli.js",
    "whatsapp-agent-serve": "dist/server-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "serve": "node dist/server-cli.js",
    "dev:serve": "tsx src/server-cli.ts"
  },
  "dependencies": {
    "@clickonsearch/openai-remote-mcp-bridge": "^0.2.0",
    "@clickonsearch/claude-remote-mcp-bridge": "^0.2.0",
    "@clickonsearch/deepseek-remote-mcp-bridge": "^0.2.0",
    "openai": "^4.68.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "@ag-ui/core": "^1.0.0",
    "@ag-ui/encoder": "^1.0.0",
    "express": "^4.21.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17"
  },
  "engines": {
    "node": ">=18"
  }
}
