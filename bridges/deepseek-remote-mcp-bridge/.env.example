DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
# Override only for a different (e.g. self-hosted/proxied) OpenAI-compatible endpoint
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# MCP servers are configured once, shared by every bridge in this repo —
# this points at the repo root's mcp.config.json. Override to point at a
# bridge-local file instead (e.g. MCP_CONFIG_PATH=./mcp.config.json).
MCP_CONFIG_PATH=../../mcp.config.json

# Referenced via ${GITHUB_TOKEN} in the shared mcp.config.json (see repo root)
GITHUB_TOKEN=
