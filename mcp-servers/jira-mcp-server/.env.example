# Your Jira Cloud site, e.g. https://yourcompany.atlassian.net
JIRA_BASE_URL=

# The email you sign in to Atlassian with, and an API token created at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# Used by create_story when no project is given, e.g. PROJ
# JIRA_PROJECT_KEY=

# Port for the MCP server
PORT=4400

# Who can connect. Default 127.0.0.1 = only this computer. Anything else
# (e.g. 0.0.0.0) also requires JIRA_MCP_TOKEN.
# BIND_HOST=127.0.0.1

# Secret every caller must send as "Authorization: Bearer <token>" (16+
# characters, e.g. `openssl rand -hex 32`). Required if BIND_HOST isn't
# 127.0.0.1. adlc-agent reads the same variable to authenticate.
# JIRA_MCP_TOKEN=
