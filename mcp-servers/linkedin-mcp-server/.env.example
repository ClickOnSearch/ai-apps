# From a LinkedIn app you create at https://www.linkedin.com/developers/apps
# (add the "Sign In with LinkedIn using OpenID Connect" and "Share on
# LinkedIn" products — both are self-serve, no approval needed)
LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET

# Must exactly match an "Authorized redirect URL" configured on the app
LINKEDIN_REDIRECT_URI=http://localhost:3300/callback

# Space-separated. w_member_social is required for create_post.
LINKEDIN_SCOPES=openid profile email w_member_social

# Where the authorize step saves your token, and where the server reads it from
LINKEDIN_TOKEN_PATH=./linkedin-token.json

# Port for the MCP server
PORT=4300

# LinkedIn's versioned REST API header (YYYYMM). Bump this if create_post
# starts failing — check LinkedIn's current API docs.
LINKEDIN_API_VERSION=202409
