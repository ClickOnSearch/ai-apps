# From a LinkedIn app you create at https://www.linkedin.com/developers/apps
# (add the "Sign In with LinkedIn using OpenID Connect" and "Share on
# LinkedIn" products — both are self-serve, no approval needed)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URL" configured on the app
LINKEDIN_REDIRECT_URI=http://localhost:3300/callback

# Space-separated. w_member_social is required for create_post.
LINKEDIN_SCOPES=openid profile email w_member_social

# Where the authorize step saves your token, and where the server reads it from
LINKEDIN_TOKEN_PATH=./linkedin-token.json

# Port for the MCP server
PORT=4300

# LinkedIn's versioned REST API header (YYYYMM). LinkedIn sunsets each
# monthly version after about a year, so this WILL go stale — if
# create_post starts failing with a 426/"NONEXISTENT_VERSION" error, get a
# current value from
# https://learn.microsoft.com/en-us/linkedin/shared/api-guide/concepts/protocol-version
LINKEDIN_API_VERSION=$(date +"%Y%m")

# Who can connect. Default 127.0.0.1 = only this computer. Anything else
# (e.g. 0.0.0.0) also requires LINKEDIN_MCP_TOKEN.
# BIND_HOST=127.0.0.1

# Secret every caller must send as "Authorization: Bearer <token>" (16+
# characters, e.g. `openssl rand -hex 32`). Required if BIND_HOST isn't
# 127.0.0.1. linkedin-agent reads the same variable to authenticate.
# LINKEDIN_MCP_TOKEN=
