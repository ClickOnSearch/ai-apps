{
  "name": "@clickonsearch/linkedin-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for a personal LinkedIn account via LinkedIn's OAuth 2.0 API: read your own profile and publish posts to your feed.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickOnSearch/ai-apps.git",
    "directory": "mcp-servers/linkedin-mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "linkedin-mcp-server": "dist/cli.js",
    "linkedin-authorize": "dist/authorize-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "authorize": "node dist/authorize-cli.js",
    "dev:authorize": "tsx src/authorize-cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.1",
    "zod": "^3.25.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.5",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=18"
  }
}
