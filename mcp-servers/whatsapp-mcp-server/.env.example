# Port for the MCP + events HTTP server
PORT=4100

# Where Baileys stores your linked-device session (auth keys). Treat this
# like a login session / API key — never commit it, never share it.
WHATSAPP_AUTH_DIR=./whatsapp-auth

# "silent" | "info" | "debug" | "trace" (Baileys' own connection logging)
BAILEYS_LOG_LEVEL=silent

# Who can connect. Default 127.0.0.1 = only this computer. Anything else
# (e.g. 0.0.0.0) also requires WHATSAPP_MCP_TOKEN.
# BIND_HOST=127.0.0.1

# Secret every caller must send as "Authorization: Bearer <token>" (16+
# characters, e.g. `openssl rand -hex 32`). Required if BIND_HOST isn't
# 127.0.0.1. whatsapp-agent reads the same variable to authenticate.
# WHATSAPP_MCP_TOKEN=
