# Port for the MCP + events HTTP server
PORT=4100

# Where Baileys stores your linked-device session (auth keys). Treat this
# like a login session / API key — never commit it, never share it.
WHATSAPP_AUTH_DIR=./whatsapp-auth

# "silent" | "info" | "debug" | "trace" (Baileys' own connection logging)
BAILEYS_LOG_LEVEL=silent
