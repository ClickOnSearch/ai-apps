{
  "name": "@clickonsearch/agent-skills",
  "version": "0.1.0",
  "description": "Reusable, provider- and MCP-server-agnostic system-prompt modules (\"skills\") that any agent in this repo can layer on top of its own base instructions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickOnSearch/ai-apps.git",
    "directory": "skills/agent-skills"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-skills": "dist/cli.js",
    "agent-skills-mcp": "dist/mcp-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.5"
  },
  "engines": {
    "node": ">=18"
  }
}
